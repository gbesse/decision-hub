{
  "name": "@gbesse/decision-hub",
  "version": "0.1.1",
  "private": true,
  "description": "Private Jev policy workspaces with tenant-isolated persistence and revocable aggregate reports.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node scripts/local-preview.mjs",
