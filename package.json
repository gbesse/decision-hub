    "release:check": "npm run check && npm test",
    "db:generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "@playwright/test": "1.63.0"
  },
  "overrides": {
    "esbuild": "0.25.12"
  }
}
